"""A repository rule that exposes the C++ standard library header lists.

The lists live in text files so that the CMake build can read them too. BUILD
files can't read files, so this rule turns them into `headers.bzl`, which
defines `LIBCXX_HEADERS`, `LIBC_HEADERS` and `NON_APPLE_LIBC_HEADERS`.
"""

_LISTS = {
    "LIBCXX_HEADERS": Label("//support/cc_std_impl:libcxx_headers.txt"),
    "LIBC_HEADERS": Label("//support/cc_std_impl:libc_headers.txt"),
    "NON_APPLE_LIBC_HEADERS": Label("//support/cc_std_impl:non_apple_libc_headers.txt"),
}

def _parse_headers(content):
    """Returns the header names in `content`, skipping blank lines and comments."""
    headers = []
    for line in content.splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            headers.append(line)
    return headers

def _std_headers_impl(rctx):
    lines = ['"""Generated by std_headers_repo.bzl. Do not edit."""', ""]
    for name, label in _LISTS.items():
        # Reading the file also makes Bazel refetch this repository when the
        # file changes.
        lines.append("{} = {}".format(name, _parse_headers(rctx.read(label))))
    rctx.file("headers.bzl", "\n".join(lines) + "\n")
    rctx.file("BUILD.bazel", "")

std_headers = repository_rule(
    implementation = _std_headers_impl,
    doc = "Generates `headers.bzl` from the header lists in support/cc_std_impl.",
)
