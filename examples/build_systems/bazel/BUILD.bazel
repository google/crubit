load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load(
    "@rules_crubit//bazel:cpp_api_from_rust.bzl",
    "cpp_api_from_rust",
)
load("@rules_rust//rust:rust_library.bzl", "rust_library")

cc_binary(
    name = "main",
    srcs = ["main.cpp"],
    deps = [
        ":lib_cc_api",
    ],
)

rust_library(
    name = "lib",
    srcs = ["rust_lib/src/lib.rs"],
    edition = "2024",
    deps = [
        "@crates//base64",
    ],
)

cpp_api_from_rust(
    name = "lib_cc_api",
    crate = ":lib",
)
